{
  "name": "polaris-core",
  "version": "1.0.5",
  "description": "Polaris is a front-end web framework for creating responsive UI components.",
  "author": "Hemin Satya",
  "license": "MIT",
  "main": "index.js",
  "style": "/dist/css/polaris.css",
  "sass": "/src/scss/polaris.scss",
  "javascript": "/dist/js/polaris.js",
  "typescript": "/src/ts/polaris.ts",
  "types": "/dist/js/polaris.d.ts",
  "module": "/dist/js/modules/Core.js",
  "keywords": [
    "CSS",
    "Sass",
    "JavaScript",
    "TypeScript",
    "webpack",
    "HTML",
    "responsive-design",
    "front-end",
    "Web",
    "Framework"
  ],
  "homepage": "https://github.com/heminsatya/polaris-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heminsatya/polaris-core.git"
  },
  "bugs": {
    "url": "https://github.com/heminsatya/polaris-core/issues"
  },
  "devDependencies": {
    "@types/node": "18.19.0",
    "inspectpack": "4.7.1",
    "sass": "1.105.2",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.0",
    "webpack-cli": "5.1.4"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css": "sass src/scss/polaris.scss dist/css/polaris.min.css --style compressed --load-path=node_modules --no-source-map --silence-deprecation=import,global-builtin,if-function",
    "css-dev": "sass src/scss/polaris.scss dist/css/polaris.css --watch --load-path=node_modules --silence-deprecation=import,global-builtin,if-function",
    "css-rtl": "sass src/scss/polaris-rtl.scss dist/css/polaris-rtl.min.css --style compressed --load-path=node_modules --no-source-map --silence-deprecation=import,global-builtin,if-function",
    "css-rtl-dev": "sass src/scss/polaris-rtl.scss dist/css/polaris-rtl.css --watch --load-path=node_modules --silence-deprecation=import,global-builtin,if-function",
    "js-mod": "tsc --watch",
    "js": "webpack",
    "js-dev": "webpack --config webpack.config.dev.js"
  }
}
